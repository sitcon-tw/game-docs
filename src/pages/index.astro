---
import { render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import { getSortedDocsEntries, toDocsChapters } from '../lib/docs-content';

const entries = await getSortedDocsEntries();
const chapters = toDocsChapters(entries);
const entry = entries[0];
const current = chapters[0];
const next = chapters[1];

if (!entry || !current) {
	throw new Error('No docs chapters found.');
}

const { Content } = await render(entry);
---

<DocsLayout chapters={chapters} current={current} next={next}>
	<Content />
</DocsLayout>
